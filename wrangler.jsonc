{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dash-dev",
  "main": "packages/container-worker/src/index.ts",
  "compatibility_date": "2026-10-19",
  "secrets": {
    "required": ["DASH_SECRET"]
  },
  "workers_dev": false,
  "upload_source_maps": true,
  "vars": {
    "DASH_SEED_DEMO": "false"
  },
  "routes": [
    {
      "pattern": "dev.dash.io",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "DashContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
      "rollout_step_percentage": 100
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DASH_CONTAINER",
        "class_name": "DashContainer"
      }
    ]
  },
  "exports": {
    "DashContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
