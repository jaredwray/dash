{
  "name": "dash",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @dash/web dev",
    "dev:site": "pnpm --filter @dash/site dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:services:start": "bash ./scripts/test-services.sh start",
    "test:services:stop": "bash ./scripts/test-services.sh stop",
    "test:shutdown": "node ./scripts/shutdown-smoke.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "deploy:dev": "wrangler deploy",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
