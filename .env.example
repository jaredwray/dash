# Required in production. Used to sign sessions and derive the credential encryption key.
DASH_SECRET=change-me-in-production

# SQLite file for app state (users, sessions, dashboards, data source configs).
DASH_DATABASE_PATH=./data/dash.sqlite

# When true (default in development), seed admin@dash.dev / dashadmin plus a demo dashboard.
DASH_SEED_DEMO=true
