# Required in production. Used to sign sessions and derive the credential encryption key.
DASH_SECRET=change-me-in-production

# App state (users, sessions, tokens, settings, data sources, dashboards).
# The path is the database name. Dash creates that database on the first connection.
# A username with no authSource authenticates against admin, where Atlas stores SCRAM
# users. The user needs the readWrite role on the database. dbAdmin cannot insert
# accounts. Example: mongodb+srv://dash:<password>@cluster.example.mongodb.net/dash
# dev.dash.io reads this from a Worker secret.
MONGODB_URI=mongodb://127.0.0.1:27017/dash

# When true (default), seed admin@dash.dev / dashadmin and show that login on the
# sign-in page. Set to false for an empty workspace: create the first
# administrator at /register. The demo login is hidden in that mode.
DASH_SEED_DEMO=true

# When true outside production, Settings shows "Sample company data". An administrator
# can write the Fernway sample company into the configured Postgres, MongoDB, and
# BigQuery sources. Production ignores this flag. See the README.
DASH_SEED_DEV_SOURCES=false
